# Google: OAuth 2.0 Client ID of type "Web application"
VITE_GOOGLE_CLIENT_ID=
# Microsoft: Application (client) ID of an app registration with a "Single-page application" platform
VITE_MS_CLIENT_ID=
# Optional: "common" (personal + work accounts, default), "consumers", "organizations" or a tenant id
VITE_MS_TENANT=common
